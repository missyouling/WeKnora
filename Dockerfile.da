# ============================================================
# WeKnora Daily-Affairs Sandbox Image (二开专用)
# 不修改官方 docker/Dockerfile.app，此文件独立维护
# 目标：单镜像部署，后端托管前端静态文件，仅 amd64
# ============================================================

# ---------- Stage 1: 前端构建 ----------
FROM --platform=$BUILDPLATFORM node:24-bookworm-slim AS builder-web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend/ ./
ARG VITE_FRONTEND_COMMIT=sandbox
RUN npm run build

# ---------- Stage 2: 后端构建 ----------
FROM --platform=$TARGETPLATFORM golang:1.26-bookworm AS builder-go
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential libsqlite3-dev curl && rm -rf /var/lib/apt/lists/*
COPY go.mod go.sum ./
COPY third_party/anydoc-go/go.mo[d] third_party/anydoc-go/
RUN go mod download
COPY . .
ENV CGO_ENABLED=1
ENV CGO_CFLAGS="-O2 -g"
# 链接 anydoc 进程内解析引擎（Office 文档转 Markdown，无需 Python docreader）。
# 需要 Rust 工具链构建静态归档（third_party/anydoc-go，~30MB），构建阶段增加数分钟。
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable && \
    bash ./scripts/build-anydoc-lib.sh
# 版本戳：/api/v1/system/info 的 commit_id / build_time 默认都是 "unknown"，
# 线上排查无法把运行中的实例对应到具体提交。由 ARG 注入 Git SHA（CI 传
# github.sha），构建时刻生成 UTC 时间戳；两者经 -ldflags -X 写入包变量。
# 未显式传参时退回 unknown，不改变本地/CI 之外的构建行为。
ARG GIT_COMMIT=unknown
RUN BUILD_STAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)" && \
    go build -tags anydoc \
      -ldflags "-X github.com/Tencent/WeKnora/internal/handler.CommitID=${GIT_COMMIT} -X github.com/Tencent/WeKnora/internal/handler.BuildTime=${BUILD_STAMP}" \
      -o WeKnora ./cmd/server

# ---------- Stage 3: 运行时 ----------
FROM debian:12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libsqlite3-0 tzdata curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder-go /app/WeKnora ./WeKnora
COPY --from=builder-go /app/config ./config
COPY --from=builder-go /app/migrations ./migrations
COPY --from=builder-go /app/scripts ./scripts
COPY --from=builder-web /web/dist ./web/dist
EXPOSE 8080
CMD ["./WeKnora"]
